# docker compose env file. Copy to .env (never commit .env). All DD_* variables are documented
# in configs/serve.env.example.

# Folder name under ./models to serve (an exported, checksummed model version).
MODEL_VERSION=20261007T173514Z_c9fca37c51cb

DD_ENVIRONMENT=production
# REQUIRED in production: comma-separated keys, each >= 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DD_API_KEYS=
DD_LOG_LEVEL=INFO
DD_INFERENCE_THREADS=2
DD_MAX_CONCURRENT_INFERENCES=1
DD_RATE_LIMIT=120/minute

# Streamlit UI: the key stays server-side. Set it to one of DD_API_KEYS locally.
DD_UI_API_URL=http://127.0.0.1:8000
DD_UI_API_KEY=
