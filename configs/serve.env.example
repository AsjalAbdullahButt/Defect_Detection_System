# Serving configuration (environment variables only; validated at startup, invalid = no start).
# Copy to .env and adjust. Never commit a real .env. Defaults shown are the built-in values.

# REQUIRED: folder with model.onnx, model_meta.json and SHA256SUMS (verified at startup).
DD_MODEL_DIR=models/<model_version>

# production disables /docs and /openapi.json. development enables them.
DD_ENVIRONMENT=production
DD_LOG_LEVEL=INFO

# Upload limits (bytes). Bodies over the limit get 413, checked while streaming.
DD_MAX_UPLOAD_BYTES=5242880
DD_MAX_BATCH_FILES=16
DD_MAX_BATCH_BYTES=33554432
# Image checks: side lengths in px, pixel cap (decompression bombs), max aspect ratio.
DD_MIN_IMAGE_SIDE=32
DD_MAX_IMAGE_SIDE=4096
DD_MAX_IMAGE_PIXELS=16000000
DD_MAX_ASPECT_RATIO=4.0

# CPU budget: inference_threads x max_concurrent_inferences should not exceed the cores
# given to the container (otherwise threads fight each other and latency gets worse).
DD_INFERENCE_THREADS=2
DD_MAX_CONCURRENT_INFERENCES=2
# Requests beyond max_concurrent_inferences get 503; slower than this get 504.
DD_INFERENCE_TIMEOUT_S=10

# API-key auth on /v1/* (header X-API-Key). Comma-separated; each key >= 32 characters.
# Several keys allow rotation: add the new key, move clients over, remove the old key.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Production refuses to start without keys unless DD_ALLOW_UNAUTHENTICATED=true.
DD_API_KEYS=
DD_ALLOW_UNAUTHENTICATED=false
# Rate limits per caller (API-key fingerprint, else client IP), per worker process.
DD_RATE_LIMIT=120/minute
DD_AUTH_FAILURE_LIMIT=10/minute
# CORS allow-list (comma-separated origins). Empty = CORS disabled.
DD_CORS_ORIGINS=

# Prometheus metrics on a separate internal port (do not publish it publicly).
# Leave DD_METRICS_PORT empty to disable. In a container use DD_METRICS_HOST=0.0.0.0 and
# keep the port on the internal network only.
DD_METRICS_PORT=9100
DD_METRICS_HOST=127.0.0.1
